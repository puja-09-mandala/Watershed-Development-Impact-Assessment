
var roi = ee.FeatureCollection("FAO/GAUL/2015/level2")
            .filter(ee.Filter.eq('ADM2_NAME', 'Mahbubnagar'));

Map.centerObject(roi, 9);

function maskLandsat(image) {
  var qa = image.select('QA_PIXEL');
  var mask = qa.bitwiseAnd(1 << 3).eq(0)
              .and(qa.bitwiseAnd(1 << 4).eq(0));
  return image.updateMask(mask);
}


var l5 = ee.ImageCollection("LANDSAT/LT05/C02/T1_L2")
          .filterBounds(roi)
          .filterDate('2004-01-01', '2004-12-31')
          .map(maskLandsat)
          .median();

// Convert to temperature (Kelvin → Celsius)
var lst_2004 = l5.select('ST_B6')
                 .multiply(0.00341802)
                 .add(149.0)
                 .subtract(273.15)
                 .clip(roi);

var l8 = ee.ImageCollection("LANDSAT/LC08/C02/T1_L2")
          .filterBounds(roi)
          .filterDate('2024-01-01', '2024-12-31')
          .map(maskLandsat)
          .median();

var lst_2024 = l8.select('ST_B10')
                 .multiply(0.00341802)
                 .add(149.0)
                 .subtract(273.15)
                 .clip(roi);



var lstVis = {
  min: 20,
  max: 45,
  palette: [
    '#0000FF',  // cool (blue)
    '#00FFFF',  // cyan
    '#00FF00',  // green
    '#FFFF00',  // yellow
    '#FFA500',  // orange
    '#FF0000'   // hot (red)
  ]
};


var layer2004 = ui.Map.Layer(lst_2004, lstVis, 'LST 2004', true);
var layer2024 = ui.Map.Layer(lst_2024, lstVis, 'LST 2024', false);

Map.layers().reset([layer2004, layer2024]);
