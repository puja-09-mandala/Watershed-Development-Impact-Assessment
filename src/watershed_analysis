
var roi = ee.FeatureCollection("FAO/GAUL/2015/level2")
            .filter(ee.Filter.eq('ADM2_NAME', 'Mahbubnagar'));

Map.centerObject(roi, 9);
Map.addLayer(roi, {color: 'black'}, 'Boundary');

function maskLandsat(image) {
  var qa = image.select('QA_PIXEL');
  var mask = qa.bitwiseAnd(1 << 3).eq(0)
              .and(qa.bitwiseAnd(1 << 4).eq(0));
  return image.updateMask(mask);
}

var l5 = ee.ImageCollection("LANDSAT/LT05/C02/T1_L2")
          .filterBounds(roi)
          .filterDate('2004-01-01', '2004-12-31')
          .map(maskLandsat)
          .median();

var l8 = ee.ImageCollection("LANDSAT/LC08/C02/T1_L2")
          .filterBounds(roi)
          .filterDate('2024-01-01', '2024-12-31')
          .map(maskLandsat)
          .median();

var ndvi_2004 = l5.normalizedDifference(['SR_B4', 'SR_B3']).clip(roi);
var ndvi_2024 = l8.normalizedDifference(['SR_B5', 'SR_B4']).clip(roi);

var ndviVis = {
  min: -1,
  max: 1,
  palette: ['white','yellow','lightgreen','green','darkgreen']
};


var lst_2004 = l5.select('ST_B6')
  .multiply(0.00341802).add(149.0).subtract(273.15).clip(roi);

var lst_2024 = l8.select('ST_B10')
  .multiply(0.00341802).add(149.0).subtract(273.15).clip(roi);

var lstVis = {
  min: 20,
  max: 45,
  palette: ['blue','cyan','green','yellow','orange','red']
};

// ==========================================
function classify(image, nir, red, swir, green) {

  var ndvi = image.normalizedDifference([nir, red]);
  var ndbi = image.normalizedDifference([swir, nir]);
  var ndwi = image.normalizedDifference([green, nir]);

  var water = ndwi.gt(0.3);
  var vegetation = ndvi.gt(0.4);
  var builtup = ndbi.gt(0.2);

  var lulc = ee.Image(0)
    .where(water, 1)
    .where(vegetation.and(water.not()), 2)
    .where(builtup.and(water.not()).and(vegetation.not()), 3)
    .where(ndvi.lt(0.2).and(ndwi.lt(0)), 4);

  return lulc.clip(roi);
}


// APPLY CLASSIFICATION (IMPORTANT)
var lulc_2004 = classify(l5, 'SR_B4','SR_B3','SR_B5','SR_B2');
var lulc_2024 = classify(l8, 'SR_B5','SR_B4','SR_B6','SR_B3');

var lightPalette = [
  '#a2d2ff', // Soft Sky Blue (Water)
  '#ffafcc', // Soft Pink (Urban/Built-up)
  '#b7e4c7', // Soft Mint Green (Forest)
  '#fdfd96', // Pastel Yellow (Cropland)
  '#e9ecef'  // Very Light Grey (Barren)
];

var lulcVis = {
  min: 0,
  max: 4, 
  palette: lightPalette,
  opacity: 0.75 // Increased from your current setting for better visibility
};


Map.layers().reset([

  // NDVI
  ui.Map.Layer(ndvi_2004, ndviVis, 'NDVI 2004', false),
  ui.Map.Layer(ndvi_2024, ndviVis, 'NDVI 2024', false),

  // LST
  ui.Map.Layer(lst_2004, lstVis, 'LST 2004', false),
  ui.Map.Layer(lst_2024, lstVis, 'LST 2024', false),

  // LULC (DEFAULT ON)
  ui.Map.Layer(lulc_2004, lulcVis, 'LULC 2004', true, 0.8),
  ui.Map.Layer(lulc_2024, lulcVis, 'LULC 2024', false, 0.8)

]);
