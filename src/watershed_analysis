// Function to create row
function makeRow(color, name) {
  var colorBox = ui.Label({
    style: {
      backgroundColor: color,
      padding: '8px',
      margin: '2px',
      border: '1px solid black'
    }
  });

  var label = ui.Label(name, {
    margin: '4px'
  });

  return ui.Panel([colorBox, label], ui.Panel.Layout.Flow('horizontal'));
}

